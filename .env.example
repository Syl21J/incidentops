# PostgreSQL container and application settings (local development only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=incidentops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=incidentops

# Elasticsearch infrastructure and WSL search-client settings
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
ELASTICSEARCH_URL=http://localhost:9200

# Prometheus container and WSL metric-client settings
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_SCRAPE_INTERVAL=2s

# Kafka infrastructure and application settings
KAFKA_EXTERNAL_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders.v1
KAFKA_CONSUMER_GROUP=incidentops-order-consumer-v1
KAFKA_AUTO_OFFSET_RESET=earliest
# This local KRaft cluster identifier is not a secret.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Application settings
LOG_LEVEL=INFO
THIRD_PARTY_LOG_LEVEL=WARNING
LOG_FILE_ENABLED=true
LOG_DIRECTORY=logs
RUN_ID=local
ORDER_RANDOM_SEED=42

# Prometheus endpoints exposed by the Python applications in WSL
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
PRODUCER_METRICS_PORT=8001
CONSUMER_METRICS_PORT=8002
CONSUMER_LAG_UPDATE_INTERVAL_SECONDS=2

# Development/test-only incident injection; disabled by default
CONSUMER_PROCESSING_DELAY_MS=0
SLOW_PROCESSING_THRESHOLD_MS=500

# Live OpenAI-compatible model configuration; test mode must be selected explicitly
LLM_PROVIDER=openai-compatible
LLM_MODEL=replace-with-model-name
LLM_BASE_URL=
LLM_API_KEY=replace-with-api-key
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Hard-bounded investigation workflow settings
INVESTIGATION_MAX_TIME_RANGE_HOURS=6
INVESTIGATION_MAX_TOOL_CALLS=10
INVESTIGATION_MAX_ATTEMPTS=2
INVESTIGATION_ARTIFACT_DIRECTORY=artifacts/investigations
